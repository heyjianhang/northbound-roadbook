# 在高德开放平台创建「Web端（JS API）」应用；不要填 Web服务 Key。
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
# 生产服务器监听地址可改成 0.0.0.0，通过反向代理提供 HTTPS。
HOST=127.0.0.1
PORT=4173

# 账户数据库：部署时放在持久化目录，禁止放在 public 或 dist 内。
ACCOUNTS_DB_PATH=.runtime/accounts.sqlite
# 部署时填写实际 HTTPS 访问地址，不含路径；本地开发留空。
PUBLIC_ORIGIN=

# 独立管理账号：仅用于邀请和管理成员；你和旅伴通过邀请注册个人账号。
# 修改后重启服务。密码 10–128 个字符，不配置密码时禁用管理账号。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=系统管理员

# 旅行助手：也可在管理员页面配置。下列非空环境变量优先，修改后重启。
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=
# 向量模型与对话共用接口、密钥；留空使用关键词检索。
AGENT_EMBEDDING_MODEL=
AGENT_DATA_DIR=.runtime/agent
# 留空默认使用项目 .venv/bin/python（Python 3.11+）。
AGENT_PYTHON=

# 火山 / 豆包语音：开通“录音文件识别极速版”，资源 ID 为 volc.bigasr.auc_turbo。
# 新版控制台填写 API Key；旧版填写 App ID 和 Access Token。API Key 优先。
# 也可在管理员页面配置；非空环境变量优先，修改后重启。
VOLC_SPEECH_API_KEY=
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=

# MCP 微服务：本地开发留空会自动启动独立 Python 网关进程。
# 使用 compose.yaml 时，需要设置随机的网关连接密钥。
MCP_GATEWAY_URL=
MCP_GATEWAY_TOKEN=
# 内置飞猪独立运行环境的可执行文件路径（确认接入方式并安装后填写）
MCP_FLIGGY_COMMAND=

# Docker 构建可选软件源；留空使用默认 Debian / PyPI 源。
# 腾讯云服务器可分别填写 http://mirrors.cloud.tencent.com 与 https://mirrors.cloud.tencent.com/pypi/simple。
ROADBOOK_DEBIAN_MIRROR=
ROADBOOK_PYPI_INDEX_URL=

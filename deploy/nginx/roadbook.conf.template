server {
    listen 80;
    server_name roadbook.heyjianhang.top;

    access_log /var/log/nginx/roadbook.heyjianhang.top.access.log;
    error_log /var/log/nginx/roadbook.heyjianhang.top.error.log;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        try_files $uri =404;
    }
    location / {
        return 308 https://roadbook.heyjianhang.top$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name roadbook.heyjianhang.top;

    ssl_certificate __FULLCHAIN__;
    ssl_certificate_key __PRIVKEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:roadbook_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log /var/log/nginx/roadbook.heyjianhang.top.access.log;
    error_log /var/log/nginx/roadbook.heyjianhang.top.error.log;

    client_max_body_size 8m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    proxy_cache off;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_buffering off;
        proxy_read_timeout 300s;
        gzip off;
    }

    location / {
        proxy_pass http://127.0.0.1:4173;
    }
}
